{
  "name": "optcg-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:engine": "pnpm --filter @optcg/engine run build",
    "dev": "pnpm --filter @optcg/engine run build && pnpm --filter @optcg/client run dev",
    "test": "pnpm -r --no-bail run test",
    "typecheck": "pnpm -r --no-bail run typecheck",
    "sim": "pnpm --filter @optcg/engine run sim"
  },
  "devDependencies": {
    "pnpm": "10.34.5"
  }
}
