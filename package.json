{
  "name": "optcg-monorepo",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:engine": "pnpm --filter @optcg/engine build",
    "dev": "pnpm --filter @optcg/engine build && pnpm --filter @optcg/client dev",
    "test": "pnpm --filter @optcg/engine build && pnpm -r test",
    "typecheck": "pnpm --filter @optcg/engine build && pnpm -r typecheck",
    "sim": "pnpm --filter @optcg/engine sim"
  }
}
