{
  "name": "@optcg/cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./starters": "./dist/starters.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen:starters": "node --experimental-strip-types scripts/gen-starters.ts",
    "gen:starter-images": "node --experimental-strip-types scripts/gen-starter-images.ts",
    "images": "node --experimental-strip-types scripts/download-card-images.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "ingest": "node --experimental-strip-types scripts/ingest.ts"
  },
  "dependencies": {
    "@optcg/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
